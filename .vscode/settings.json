{
	"[latex]": {
		"editor.formatOnPaste": false,
		"editor.suggestSelection": "recentlyUsedByPrefix",
		"editor.wordWrap": "on"
	},
	"latex-workshop.latex.recipe.default": "Overleaf",
	"latex-workshop.latex.recipes": [
		{
			"name": "Overleaf",
			"tools": [
				"Overleaf",
			],
		},
		{
			"name": "Overleaf (re-build)",
			"tools": [
				"Overleaf (re-build)",
			],
		}
	],
	"latex-workshop.latex.tools": [
		{
			"name": "Overleaf",
			"command": "latexmk",
			"args": [
				"-pdf",
				"-auxdir=.build/",
				"-f",
				"main",
			],
		},
		{
			"name": "Overleaf (re-build)",
			"command": "latexmk",
			"args": [
				"-pdf",
				"-auxdir=.build/",
				"-f",
				"main",
				"-gg",
			],
		},
	],
	"latex-workshop.latex.clean.command": "latexmk",
	"latex-workshop.latex.clean.args": [
		"-auxdir=.build",
		"-c",
		"%TEX%",
	],
}