    \textbf{Endereço eletrónico: }\endeletronico\\
    \textbf{Título da Dissertação: }\@title\\
    \textbf{Subtítulo da Dissertação: }\subtitle\\
    \textbf{Orientador: }\orient\\
    \textbf{Coorientador: }\coorient\\
    \textbf{Ano de conclusão: }2025\\
    \textbf{Designação do Curso de Mestrado: }\curso\\[8mm]
