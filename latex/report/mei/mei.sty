\newenvironment{resumo}{
\cleardoublepage
    {\fontfamily{cmss}\selectfont
    \noindent {\Large \bf \textsc{\@title}}\\[1mm]
    \noindent {\Large \textsc{\subtitle}}\\[8mm]
    {\large \textbf{RESUMO}}}

    \setlength{\parskip}{2ex}
    % entrada no indice sem numeracao
    {\csname phantomsection\endcsname\addcontentsline{toc}{chapter}{RESUMO}}
}{
    \ifthenelse{\isundefined{\@keywords}}{}{
        \ifthenelse{\isundefined{\keywordsPage}}{
            \\[7mm]
            {\large\textbf{Palavras-Chave}}\\[4mm]
            \@keywords
        }{}
    }
    \vfill\newpage
}


\newenvironment{abstract}{
\cleardoublepage
    {\fontfamily{cmss}\selectfont
    \noindent {\Large \bf \textsc{\@title}}\\[1mm]
    \noindent {\Large \textsc{\subtitle}}\\[8mm]
    {\large \textbf{ABSTRACT}}}

    \setlength{\parskip}{2ex}
    % entrada no indice sem numeracao
    {\csname phantomsection\endcsname\addcontentsline{toc}{chapter}{ABSTRACT}}
}{
    \ifthenelse{\isundefined{\@keywords}}{}{
        \ifthenelse{\isundefined{\keywordsPage}}{
            \\[7mm]
            {\large\textbf{Keywords}}\\[4mm]
            \@keywords
        }{}
    }
    \vfill\newpage
}

\newenvironment{acknowledgments}{
\cleardoublepage
    {\fontfamily{cmss}\selectfont
    {\large \textbf{ACKNOWLEDGEMENTS}}}

    \setlength{\parskip}{2ex}
    % entrada no indice sem numeracao
    {\csname phantomsection\endcsname\addcontentsline{toc}{chapter}{ACKNOWLEDGEMENTS}}
}{
    \vfill\newpage
}

