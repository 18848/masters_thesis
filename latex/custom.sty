% code listing
\lstdefinestyle{customstyle}{
    basicstyle=\ttfamily\footnotesize,
    breakatwhitespace=false,
    breaklines=true,
    captionpos=b,
    keepspaces=true,
    numbersep=5pt,
	numbers=left,
    showspaces=false,
    showstringspaces=false,
    showtabs=false, 
    frame=single,
    frameround=ttff,
    tabsize=2,
}

\lstset{style=customstyle}

%custom online citation for biblatex
\DeclareCiteCommand{\onlinecite}
  {\usebibmacro{prenote}}
  {\ifentrytype{online}
     {\footnote{\printnames{author}%
      \setunit{\addspace}%
      \printfield[textit]{title}%
      \setunit{\addspace}%
      \printtext[brackets]{\url{\thefield{url}}}}}
     {\printnames{labelname}\space\printfield{year}}} % Fallback for other types
  {\multicitedelim}
  {\usebibmacro{postnote}}

